APP_NAME=JetGrid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# JetGrid
# ---------------------------------------------------------------------------
# SAFETY: read-only is the shipped default. Nothing JetGrid can do will write to
# this server until you deliberately change this.
JETGRID_READONLY=true
# With READONLY=true the in-app switch is inert unless this is also true. Set it
# over SSH only when you want the panel to be able to unlock itself.
JETGRID_ALLOW_RUNTIME_UNLOCK=false
# Every privileged action shows its literal shell command and asks first.
JETGRID_DRY_RUN_DEFAULT=true
# Makes dry-run non-overridable. Useful while you are still evaluating JetGrid.
JETGRID_FORCE_DRY_RUN=false

# "fake" reads fixtures and CANNOT execute anything - the safe default and what
# local development uses. Set to "linux" only on the real server.
JETGRID_DRIVER=fake

# Isolation: JetGrid never writes outside these paths.
JETGRID_USER=jetgrid
JETGRID_ROOT=/opt/jetgrid
JETGRID_SITES_ROOT=/srv/jetgrid/sites
JETGRID_CONFIG_BACKUP_DIR=/var/backups/jetgrid/configs

# This instance. Needed for CPU-credit capacity estimates and to highlight your
# row in the instance comparison chart.
JETGRID_INSTANCE_ID=
JETGRID_INSTANCE_TYPE=
JETGRID_CLOUDWATCH=false

# Live EC2 price refresh. Needs pricing:GetProducts.
JETGRID_PRICING_API=false

# ---------------------------------------------------------------------------
# External reachability + Telegram alerting
# ---------------------------------------------------------------------------
# Checking a domain from the outside is read-only and needs no privileged
# command: DNS goes over DoH and registrar status over RDAP, both plain HTTPS.

# This server's public address, used for "does the domain still point here?".
# Leave blank to auto-detect once an hour. Set it explicitly behind NAT.
JETGRID_PUBLIC_IP=

# Telegram. Create a bot with @BotFather, then message it and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert discipline. Alerts fire on state changes only; these bound the rest.
# A failure must be seen this many times in a row before it is believed.
JETGRID_ALERT_FAILURE_THRESHOLD=2
# Ceiling per site per check type.
JETGRID_ALERT_RATE_LIMIT_MIN=60
# Above this many sites failing at once, send one digest instead of one each.
JETGRID_ALERT_DIGEST_THRESHOLD=3
# Sent daily whether or not anything is wrong, so silence is never ambiguous.
JETGRID_DAILY_SUMMARY_AT=09:00

# ---------------------------------------------------------------------------
# Local project discovery & control (L0)
# ---------------------------------------------------------------------------
# "local" enables discovery of, and start/stop control over, the project folders
# next to JetGrid on THIS machine. It is one of four independent checks - the
# app must also be APP_ENV=local, no production marker file may exist, and
# PlatformDetector must not recognise a headless server. Default: production.
JETGRID_MODE=local
# Extra scan roots, comma separated. The parent of JetGrid's own directory is
# always scanned and needs no entry here.
JETGRID_LOCAL_ROOTS=
JETGRID_LOCAL_MAX_DEPTH=2
JETGRID_LOCAL_CACHE_TTL=300
JETGRID_LOCAL_POLL_MS=5000
# Pick the next free port when the preferred one is already taken.
JETGRID_LOCAL_AUTO_PORT=false
