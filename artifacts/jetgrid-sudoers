# ---------------------------------------------------------------------------
# JetGrid sudoers whitelist
#
# GENERATED by `php artisan jetgrid:sudoers` from
# App\Services\Privilege\CommandRegistry. Do not edit by hand — edit the
# registry and regenerate, so the code and this file cannot disagree.
#
# Generated: 2026-09-08 03:27:51
#
# REVIEW THIS FILE BEFORE INSTALLING IT. Every line grants one specific
# command to the "jetgrid" user with no password. There is deliberately no
# NOPASSWD:ALL, and no shell, editor, package manager or interpreter here.
#
# A NOTE ON WILDCARDS, because it decides how much this file is worth:
#   In sudoers, a wildcard in a command ARGUMENT matches that whole argument,
#   slashes included. So `systemctl restart *` would permit
#   `systemctl restart nginx`. This file therefore keeps literal prefixes
#   (jetgrid-*) and expands small closed sets (tcp/udp, PHP versions) into
#   explicit lines, so that these rules stay narrow even if the application
#   layer above them is bypassed entirely.
#
# Install with:
#   sudo visudo -cf jetgrid-sudoers        # validate FIRST
#   sudo install -m 0440 -o root -g root jetgrid-sudoers /etc/sudoers.d/jetgrid
#
# Remove with:
#   sudo rm /etc/sudoers.d/jetgrid
# ---------------------------------------------------------------------------

Defaults:jetgrid !requiretty
Defaults:jetgrid env_reset

# === READ-ONLY =============================================================
# These are the only privileged commands JetGrid runs while
# JETGRID_READONLY=true. Discovery and monitoring need nothing else, so a
# monitoring-only install can stop after this section.

# [nginx.test] Validate nginx configuration. Required by safety constraint #5 before any reload. Read-only: -t never writes.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/nginx -t

# [nginx.dump] Dump the fully-resolved nginx config for read-only discovery of existing vhosts.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/nginx -T

# [supervisor.status] Read supervisor program states. supervisorctl needs its socket, hence sudo. Read-only subcommand.
jetgrid ALL=(root) NOPASSWD: /usr/bin/supervisorctl status

# [fail2ban.status] List fail2ban jails. Requires the fail2ban socket, hence sudo. Read-only subcommand.
jetgrid ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status

# [fail2ban.jail] Banned-IP list for one jail. Read-only subcommand.
#   BROAD ARGUMENT {jail}: fail2ban jail name; the subcommand is already fixed.
jetgrid ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status *

# [ufw.status] Firewall rules for the security panel. ufw has no unprivileged read mode.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/ufw status numbered

# [certbot.list] Inventory existing certificates, including ones JetGrid did not issue. Read-only subcommand.
jetgrid ALL=(root) NOPASSWD: /usr/bin/certbot certificates

# [crontab.list] Read a crontab for the cron manager. Read-only flag; adopted crons are displayed locked.
#   BROAD ARGUMENT {user}: Username for a read-only crontab -l.
jetgrid ALL=(root) NOPASSWD: /usr/bin/crontab -l -u *

# === WRITES ================================================================
# Refused entirely by the application while JETGRID_READONLY=true, and
# refused for adopted sites in every mode. For a strictly monitoring-only
# install, DELETE this whole section: JetGrid degrades cleanly to read-only
# and the write actions simply fail.

# [nginx.reload] Apply a new managed vhost. Only ever reached after nginx.test passes (safety constraint #5). Reload, not restart, so live sites keep serving.
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload nginx

# [nginx.enable_site] Enable a JetGrid-created vhost. Both paths are constrained to the jetgrid- prefix, so an existing site symlink cannot be named.
jetgrid ALL=(root) NOPASSWD: /bin/ln -sfn /etc/nginx/sites-available/jetgrid-* /etc/nginx/sites-enabled/jetgrid-*

# [nginx.disable_site] Disable a JetGrid-created vhost. The pattern makes it impossible to name a non-JetGrid site.
jetgrid ALL=(root) NOPASSWD: /bin/rm -f /etc/nginx/sites-enabled/jetgrid-*

# [phpfpm.reload] Apply a new managed PHP-FPM pool. Reload rather than restart so existing workers drain instead of dropping connections held by other sites.
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php7.4-fpm
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php8.0-fpm
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php8.1-fpm
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php8.2-fpm
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php8.3-fpm
jetgrid ALL=(root) NOPASSWD: /bin/systemctl reload php8.4-fpm

# [systemd.reload_daemon] Pick up a newly written JetGrid unit file. Global but non-disruptive: it re-reads unit files, it does not restart anything.
jetgrid ALL=(root) NOPASSWD: /bin/systemctl daemon-reload

# [systemd.restart_managed] Restart a JetGrid-created worker. The jetgrid- prefix in the pattern is what stops this from ever touching an existing project unit.
jetgrid ALL=(root) NOPASSWD: /bin/systemctl restart jetgrid-*

# [certbot.issue.http01] Issue a cert via HTTP-01 for a JetGrid-managed domain. --cert-name is pinned to the domain so an existing certificate lineage cannot be overwritten.
#   BROAD ARGUMENT {domain}: A domain is unbounded, so sudo cannot restrict this to JetGrid-managed domains. The restriction to managed sites is enforced in PHP only (protected gate + policy). See the warning in the artifact.
#   BROAD ARGUMENT {email}: Contact address passed to the CA. Low consequence.
jetgrid ALL=(root) NOPASSWD: /usr/bin/certbot certonly --non-interactive --agree-tos --webroot -w /var/www/letsencrypt -d * -m * --cert-name * --keep-until-expiring

# [certbot.issue.dns01] Issue via DNS-01, for wildcards or domains not reachable on port 80.
#   BROAD ARGUMENT {domain}: A domain is unbounded, so sudo cannot restrict this to JetGrid-managed domains. The restriction to managed sites is enforced in PHP only (protected gate + policy). See the warning in the artifact.
#   BROAD ARGUMENT {email}: Contact address passed to the CA. Low consequence.
jetgrid ALL=(root) NOPASSWD: /usr/bin/certbot certonly --non-interactive --agree-tos --manual --preferred-challenges dns -d * -m * --cert-name *

# [certbot.renew] Renew ONE named managed cert. Deliberately not bare "certbot renew", which would sweep up the adopted certificates too.
#   BROAD ARGUMENT {domain}: A domain is unbounded, so sudo cannot restrict this to JetGrid-managed domains. The restriction to managed sites is enforced in PHP only (protected gate + policy). See the warning in the artifact.
jetgrid ALL=(root) NOPASSWD: /usr/bin/certbot renew --cert-name * --non-interactive

# [certbot.revoke] Revoke a managed cert. Blocked for adopted sites by the protected gate long before it reaches sudo.
#   BROAD ARGUMENT {domain}: A domain is unbounded, so sudo cannot restrict this to JetGrid-managed domains. The restriction to managed sites is enforced in PHP only (protected gate + policy). See the warning in the artifact.
jetgrid ALL=(root) NOPASSWD: /usr/bin/certbot revoke --cert-name * --non-interactive --delete-after-revoke

# [ufw.allow] Open a port. The UI warns loudly before any rule touching 22 (Feature 5).
#   BROAD ARGUMENT {port}: A port number; the subcommand is already fixed to allow/deny.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/ufw allow */tcp
jetgrid ALL=(root) NOPASSWD: /usr/sbin/ufw allow */udp

# [ufw.deny] Close a port. The same port-22 warning applies.
#   BROAD ARGUMENT {port}: A port number; the subcommand is already fixed to allow/deny.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/ufw deny */tcp
jetgrid ALL=(root) NOPASSWD: /usr/sbin/ufw deny */udp

# [fail2ban.unban] Release an IP you locked yourself out with. Narrow: only unbanip, never a jail reconfigure.
#   BROAD ARGUMENT {jail}: fail2ban jail name; the subcommand is already fixed.
#   BROAD ARGUMENT {ip}: An IP address; the subcommand is already fixed to unbanip.
jetgrid ALL=(root) NOPASSWD: /usr/bin/fail2ban-client set * unbanip *

# [user.create_site_user] Create the per-site system user. Locked to the jetgrid- prefix and to a nologin shell.
jetgrid ALL=(root) NOPASSWD: /usr/sbin/useradd --system --no-create-home --shell /usr/sbin/nologin jetgrid-*

